# SIMO 1.0.0 for the cell-to-spot mapping of the comparison method (SIMO+CellOT). simo-omics pins its own
# dependencies (anndata 0.9.2, numpy 1.22.4, scanpy 1.9.1, POT 0.8.2, ...), so it has its own image.
FROM python:3.10.16-slim-bookworm

ARG UID=1000
ARG GID=1000
ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1 PYTHONUNBUFFERED=1

RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential gfortran cmake pkg-config git tini procps libopenblas-dev \
 && rm -rf /var/lib/apt/lists/*

RUN pip install simo-omics==1.0.0 pyarrow plotly==6.2.0 && (pip check || true)

RUN groupadd -g ${GID} dev && useradd -m -u ${UID} -g ${GID} -s /bin/bash dev \
 && mkdir -p /workspace && chown dev:dev /workspace
USER dev
ENV HOME=/home/dev NUMBA_CACHE_DIR=/tmp/numba_cache MPLCONFIGDIR=/tmp/mplconfig PYTHONDONTWRITEBYTECODE=1
WORKDIR /workspace
ENTRYPOINT ["tini", "--"]
CMD ["bash"]
